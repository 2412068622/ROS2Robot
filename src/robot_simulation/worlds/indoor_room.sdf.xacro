    <xacro:macro name="mobile_robot_model" params="name x y yaw body_color cmd_vel_topic odom_topic odom_frame base_frame scan_topic imu_topic camera_topic fleet_label:=false">
      <model name="${name}">
        <static>false</static>
        <pose>${x} ${y} ${frames['base_link_height_m']} 0 0 ${yaw}</pose>
        <link name="base_link">
          <inertial>
            <mass>${base['mass_kg']}</mass>
            <inertia><ixx>${base['inertia_kg_m2']['ixx']}</ixx><iyy>${base['inertia_kg_m2']['iyy']}</iyy><izz>${base['inertia_kg_m2']['izz']}</izz></inertia>
          </inertial>
          <collision name="base_collision">
            <pose>0 0 ${float(base['height_m']) / 2.0} 0 0 0</pose>
            <geometry><box><size>${base['length_m']} ${base['width_m']} ${base['height_m']}</size></box></geometry>
          </collision>
          <visual name="base_visual">
            <pose>0 0 ${float(base['height_m']) / 2.0} 0 0 0</pose>
            <geometry><box><size>${base['length_m']} ${base['width_m']} ${base['height_m']}</size></box></geometry>
            <material><diffuse>${body_color}</diffuse></material>
          </visual>
          <xacro:if value="${fleet_label}">
            <visual name="fleet_label_visual">
              <pose>0.05 0 ${float(base['height_m']) + 0.07} 0 0 0</pose>
              <geometry><box><size>0.24 0.22 0.025</size></box></geometry>
              <material><diffuse>0.85 0.47 0.16 1</diffuse></material>
            </visual>
          </xacro:if>
          <collision name="lidar_collision">
            <pose>${sensors['lidar']['xyz_m'][0]} ${sensors['lidar']['xyz_m'][1]} ${sensors['lidar']['xyz_m'][2]} ${sensors['lidar']['rpy_rad'][0]} ${sensors['lidar']['rpy_rad'][1]} ${sensors['lidar']['rpy_rad'][2]}</pose>
            <geometry><cylinder><radius>${sensors['lidar']['radius_m']}</radius><length>${sensors['lidar']['height_m']}</length></cylinder></geometry>
          </collision>
          <visual name="lidar_visual">
            <pose>${sensors['lidar']['xyz_m'][0]} ${sensors['lidar']['xyz_m'][1]} ${sensors['lidar']['xyz_m'][2]} ${sensors['lidar']['rpy_rad'][0]} ${sensors['lidar']['rpy_rad'][1]} ${sensors['lidar']['rpy_rad'][2]}</pose>
            <geometry><cylinder><radius>${sensors['lidar']['radius_m']}</radius><length>${sensors['lidar']['height_m']}</length></cylinder></geometry>
            <material><diffuse>0.05 0.55 0.32 1</diffuse></material>
          </visual>
          <collision name="camera_collision">
            <pose>${sensors['camera']['xyz_m'][0]} ${sensors['camera']['xyz_m'][1]} ${sensors['camera']['xyz_m'][2]} ${sensors['camera']['rpy_rad'][0]} ${sensors['camera']['rpy_rad'][1]} ${sensors['camera']['rpy_rad'][2]}</pose>
            <geometry><box><size>${sensors['camera']['size_m'][0]} ${sensors['camera']['size_m'][1]} ${sensors['camera']['size_m'][2]}</size></box></geometry>
          </collision>
          <visual name="camera_visual">
            <pose>${sensors['camera']['xyz_m'][0]} ${sensors['camera']['xyz_m'][1]} ${sensors['camera']['xyz_m'][2]} ${sensors['camera']['rpy_rad'][0]} ${sensors['camera']['rpy_rad'][1]} ${sensors['camera']['rpy_rad'][2]}</pose>
            <geometry><box><size>${sensors['camera']['size_m'][0]} ${sensors['camera']['size_m'][1]} ${sensors['camera']['size_m'][2]}</size></box></geometry>
            <material><diffuse>0.05 0.55 0.32 1</diffuse></material>
          </visual>
          <sensor name="lidar" type="gpu_lidar">
            <pose>${sensors['lidar']['xyz_m'][0]} ${sensors['lidar']['xyz_m'][1]} ${sensors['lidar']['xyz_m'][2]} ${sensors['lidar']['rpy_rad'][0]} ${sensors['lidar']['rpy_rad'][1]} ${sensors['lidar']['rpy_rad'][2]}</pose>
            <topic>${scan_topic}</topic>
            <update_rate>${sim_sensors['lidar']['update_rate_hz']}</update_rate>
            <always_on>true</always_on>
            <lidar>
              <scan>
                <horizontal>
                  <samples>${sim_sensors['lidar']['samples']}</samples>
                  <resolution>${sim_sensors['lidar']['angular_resolution']}</resolution>
                  <min_angle>${sim_sensors['lidar']['min_angle_rad']}</min_angle>
                  <max_angle>${sim_sensors['lidar']['max_angle_rad']}</max_angle>
                </horizontal>
              </scan>
              <range>
                <min>${sim_sensors['lidar']['min_range_m']}</min>
                <max>${sim_sensors['lidar']['max_range_m']}</max>
                <resolution>${sim_sensors['lidar']['range_resolution_m']}</resolution>
              </range>
              <noise><type>gaussian</type><mean>0.0</mean><stddev>${sim_sensors['lidar']['noise_stddev_m']}</stddev></noise>
            </lidar>
          </sensor>
          <sensor name="imu" type="imu">
            <pose>${sensors['imu']['xyz_m'][0]} ${sensors['imu']['xyz_m'][1]} ${sensors['imu']['xyz_m'][2]} ${sensors['imu']['rpy_rad'][0]} ${sensors['imu']['rpy_rad'][1]} ${sensors['imu']['rpy_rad'][2]}</pose>
            <topic>${imu_topic}</topic>
            <update_rate>${sim_sensors['imu']['update_rate_hz']}</update_rate>
            <always_on>true</always_on>
          </sensor>
          <xacro:if value="${sim_sensors['camera']['enabled']}">
            <sensor name="camera" type="camera">
              <pose>${sensors['camera']['xyz_m'][0]} ${sensors['camera']['xyz_m'][1]} ${sensors['camera']['xyz_m'][2]} ${sensors['camera']['rpy_rad'][0]} ${sensors['camera']['rpy_rad'][1]} ${sensors['camera']['rpy_rad'][2]}</pose>
              <topic>${camera_topic}</topic>
              <update_rate>${sim_sensors['camera']['update_rate_hz']}</update_rate>
              <always_on>true</always_on>
              <camera>
                <horizontal_fov>${sim_sensors['camera']['horizontal_fov_rad']}</horizontal_fov>
                <image>
                  <width>${sim_sensors['camera']['image_width_px']}</width>
                  <height>${sim_sensors['camera']['image_height_px']}</height>
                  <format>R8G8B8</format>
                </image>
              </camera>
            </sensor>
          </xacro:if>
        </link>
        <link name="left_wheel">
          <pose>${drive_wheels['joint_x_m']} ${float(drive_wheels['center_separation_m']) / 2.0} ${drive_wheels['joint_z_m']} 1.57079632679 0 0</pose>
          <inertial><mass>${drive_wheels['mass_kg']}</mass><inertia><ixx>${drive_wheels['inertia_kg_m2']}</ixx><iyy>${drive_wheels['inertia_kg_m2']}</iyy><izz>${drive_wheels['inertia_kg_m2']}</izz></inertia></inertial>
          <collision name="collision"><geometry><cylinder><radius>${drive_wheels['radius_m']}</radius><length>${drive_wheels['width_m']}</length></cylinder></geometry></collision>
          <visual name="visual"><geometry><cylinder><radius>${drive_wheels['radius_m']}</radius><length>${drive_wheels['width_m']}</length></cylinder></geometry><material><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
        </link>
        <link name="right_wheel">
          <pose>${drive_wheels['joint_x_m']} ${-float(drive_wheels['center_separation_m']) / 2.0} ${drive_wheels['joint_z_m']} 1.57079632679 0 0</pose>
          <inertial><mass>${drive_wheels['mass_kg']}</mass><inertia><ixx>${drive_wheels['inertia_kg_m2']}</ixx><iyy>${drive_wheels['inertia_kg_m2']}</iyy><izz>${drive_wheels['inertia_kg_m2']}</izz></inertia></inertial>
          <collision name="collision"><geometry><cylinder><radius>${drive_wheels['radius_m']}</radius><length>${drive_wheels['width_m']}</length></cylinder></geometry></collision>
          <visual name="visual"><geometry><cylinder><radius>${drive_wheels['radius_m']}</radius><length>${drive_wheels['width_m']}</length></cylinder></geometry><material><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
        </link>
        <link name="caster_wheel">
          <pose>${caster['xyz_m'][0]} ${caster['xyz_m'][1]} ${caster['xyz_m'][2]} 0 0 0</pose>
          <inertial><mass>${caster['mass_kg']}</mass><inertia><ixx>${caster['inertia_kg_m2']}</ixx><iyy>${caster['inertia_kg_m2']}</iyy><izz>${caster['inertia_kg_m2']}</izz></inertia></inertial>
          <collision name="collision"><geometry><sphere><radius>${caster['radius_m']}</radius></sphere></geometry></collision>
          <visual name="visual"><geometry><sphere><radius>${caster['radius_m']}</radius></sphere></geometry><material><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
        </link>
        <joint name="left_wheel_joint" type="revolute">
          <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis>
        </joint>
        <joint name="right_wheel_joint" type="revolute">
          <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis>
        </joint>
        <joint name="caster_joint" type="fixed">
          <parent>base_link</parent><child>caster_wheel</child>
        </joint>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
          <left_joint>left_wheel_joint</left_joint>
          <right_joint>right_wheel_joint</right_joint>
          <wheel_separation>${drive_wheels['center_separation_m']}</wheel_separation>
          <wheel_radius>${drive_wheels['radius_m']}</wheel_radius>
          <topic>${cmd_vel_topic}</topic>
          <odom_topic>${odom_topic}</odom_topic>
          <frame_id>${odom_frame}</frame_id>
          <child_frame_id>${base_frame}</child_frame_id>
        </plugin>
      </model>
    </xacro:macro>

    <xacro:mobile_robot_model
      name="mobile_robot" x="0" y="0" yaw="0"
      body_color="0.08 0.28 0.70 1"
      cmd_vel_topic="/cmd_vel"
      odom_topic="/model/mobile_robot/odometry"
      odom_frame="odom" base_frame="base_link"
      scan_topic="/sim/scan" imu_topic="/sim/imu" camera_topic="/sim/camera/image"/>
    <xacro:mobile_robot_model
      name="mobile_robot_2" x="-3.9" y="-3.8" yaw="0"
      body_color="0.32 0.37 0.44 1"
      cmd_vel_topic="/robot_2/cmd_vel"
      odom_topic="/model/mobile_robot_2/odometry"
      odom_frame="robot_2/odom" base_frame="robot_2/base_link"
      scan_topic="/robot_2/sim/scan" imu_topic="/robot_2/sim/imu"
      camera_topic="/robot_2/sim/camera/image"
      fleet_label="${True}"/>

    <gui fullscreen="0">
      <!-- 默认观察机位：场景斜上方俯视 ~40°，对准房间中心，避免每次手动转视角 -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.57 0.60</ambient_light>
        <background_color>0.80 0.83 0.86</background_color>
        <camera_pose>-8.5 -8.5 7.5 0 0.62 0.785</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
    </gui>
  </world>
</sdf>
