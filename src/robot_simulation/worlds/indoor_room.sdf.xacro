<?xml version="1.0" ?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.9">
  <xacro:arg name="geometry_file" default=""/>
  <xacro:arg name="simulation_physics_file" default=""/>
  <xacro:arg name="simulation_media_directory" default=""/>
  <xacro:property name="geometry_file_path" value="$(arg geometry_file)"/>
  <xacro:property name="simulation_physics_file_path" value="$(arg simulation_physics_file)"/>
  <xacro:property name="simulation_media_path" value="$(arg simulation_media_directory)"/>
  <xacro:if value="${geometry_file_path == '' or simulation_physics_file_path == '' or simulation_media_path == ''}">
    <xacro:property name="simulation_config_error"
      value="${xacro.fatal('geometry_file, simulation_physics_file and simulation_media_directory are required')}"
      lazy_eval="false"/>
  </xacro:if>
  <xacro:property name="geometry" value="${xacro.load_yaml(geometry_file_path)}"/>
  <xacro:property name="simulation" value="${xacro.load_yaml(simulation_physics_file_path)}"/>
  <xacro:property name="frames" value="${geometry['frames']}"/>
  <xacro:property name="base" value="${geometry['base']}"/>
  <xacro:property name="drive_wheels" value="${geometry['drive_wheels']}"/>
  <xacro:property name="caster" value="${geometry['caster']}"/>
  <xacro:property name="sensors" value="${geometry['sensors']}"/>
  <xacro:property name="sim_physics" value="${simulation['physics']}"/>
  <xacro:property name="sim_sensors" value="${simulation['sensors']}"/>
  <xacro:if value="${int(geometry['schema_version']) != 1 or int(simulation['schema_version']) != 1}">
    <xacro:property name="simulation_schema_error"
      value="${xacro.fatal('unsupported robot geometry or simulation physics schema version')}"
      lazy_eval="false"/>
  </xacro:if>
  <xacro:if value="${not python.all([math.isfinite(float(v)) and float(v) > 0.0 for v in [frames['base_link_height_m'], base['length_m'], base['width_m'], base['height_m'], base['mass_kg'], drive_wheels['radius_m'], drive_wheels['width_m'], drive_wheels['center_separation_m'], caster['radius_m'], sim_physics['max_step_size_s'], sim_physics['real_time_factor'], sim_sensors['lidar']['update_rate_hz'], sim_sensors['imu']['update_rate_hz'], sim_sensors['camera']['update_rate_hz'], sim_sensors['camera']['horizontal_fov_rad'], sim_sensors['camera']['image_width_px'], sim_sensors['camera']['image_height_px']]])}">
    <xacro:property name="simulation_value_error"
      value="${xacro.fatal('robot geometry and simulation physics values must be finite and positive')}"
      lazy_eval="false"/>
  </xacro:if>
  <xacro:if value="${math.fabs(float(frames['base_link_height_m']) - float(drive_wheels['radius_m'])) > 1.0e-9 or math.fabs(float(drive_wheels['joint_z_m'])) > 1.0e-9}">
    <xacro:property name="drive_wheel_ground_contact_error"
      value="${xacro.fatal('reference AMR ground-contact invariant requires base_link_height_m == drive_wheels.radius_m and drive_wheels.joint_z_m == 0')}"
      lazy_eval="false"/>
  </xacro:if>
  <xacro:if value="${float(sim_sensors['lidar']['min_range_m']) &lt; 0.0 or float(sim_sensors['lidar']['max_range_m']) &lt;= float(sim_sensors['lidar']['min_range_m']) or float(sim_sensors['lidar']['max_angle_rad']) &lt;= float(sim_sensors['lidar']['min_angle_rad'])}">
    <xacro:property name="simulation_sensor_range_error"
      value="${xacro.fatal('simulation lidar range and angle bounds are invalid')}"
      lazy_eval="false"/>
  </xacro:if>
  <world name="indoor_room">
    <physics name="default_physics" type="ode">
      <max_step_size>${sim_physics['max_step_size_s']}</max_step_size>
      <real_time_factor>${sim_physics['real_time_factor']}</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.62 0.64 0.66 1</ambient>
      <background>0.82 0.84 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.28 0.28 0.26 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <light name="soft_fill_light" type="point">
      <pose>0 -2 5 0 0 0</pose>
      <diffuse>0.45 0.48 0.52 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.8</constant>
        <linear>0.03</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 10 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 10 0.05</size></box></geometry><material><ambient>0.66 0.67 0.65 1</ambient><diffuse>0.66 0.67 0.65 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
    </model>

    <model name="north_wall"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.1 1</size></box></geometry><material><diffuse>0.25 0.28 0.32 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.1 1</size></box></geometry><material><diffuse>0.25 0.28 0.32 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 10 1</size></box></geometry><material><diffuse>0.25 0.28 0.32 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 10 1</size></box></geometry><material><diffuse>0.25 0.28 0.32 1</diffuse></material></visual></link></model>

    <model name="storage_rack_1"><static>true</static><pose>1.5 1.5 0.35 0 0 0.3</pose><link name="link"><collision name="c"><geometry><box><size>1.2 0.45 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.45 0.7</size></box></geometry><material><diffuse>0.50 0.42 0.30 1</diffuse></material></visual></link></model>
    <model name="storage_rack_2"><static>true</static><pose>-2 2 0.35 0 0 -0.4</pose><link name="link"><collision name="c"><geometry><box><size>1.2 0.5 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.5 0.7</size></box></geometry><material><diffuse>0.50 0.42 0.30 1</diffuse></material></visual></link></model>
    <model name="packing_table"><static>true</static><pose>2 -2 0.35 0 0 0.0</pose><link name="link"><collision name="c"><geometry><box><size>0.8 1.4 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 1.4 0.7</size></box></geometry><material><diffuse>0.28 0.38 0.46 1</diffuse></material></visual></link></model>

    <model name="showcase_rack_and_workcell_detail">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="rack_a_top_beam"><pose>1.50 1.50 0.78 0 0 0.30</pose><geometry><box><size>1.34 0.06 0.08</size></box></geometry><material><diffuse>0.10 0.12 0.14 1</diffuse></material></visual>
        <visual name="rack_a_bottom_beam"><pose>1.50 1.50 0.42 0 0 0.30</pose><geometry><box><size>1.34 0.06 0.08</size></box></geometry><material><diffuse>0.10 0.12 0.14 1</diffuse></material></visual>
        <visual name="rack_a_post_1"><pose>0.94 1.31 0.55 0 0 0.30</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry><material><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
        <visual name="rack_a_post_2"><pose>2.06 1.69 0.55 0 0 0.30</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry><material><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
        <visual name="rack_b_top_beam"><pose>-2.00 2.00 0.78 0 0 -0.40</pose><geometry><box><size>1.34 0.06 0.08</size></box></geometry><material><diffuse>0.10 0.12 0.14 1</diffuse></material></visual>
        <visual name="rack_b_bottom_beam"><pose>-2.00 2.00 0.42 0 0 -0.40</pose><geometry><box><size>1.34 0.06 0.08</size></box></geometry><material><diffuse>0.10 0.12 0.14 1</diffuse></material></visual>
        <visual name="rack_b_post_1"><pose>-2.54 2.24 0.55 0 0 -0.40</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry><material><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
        <visual name="rack_b_post_2"><pose>-1.46 1.76 0.55 0 0 -0.40</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry><material><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
        <visual name="packing_conveyor"><pose>2.00 -1.36 0.78 0 0 0</pose><geometry><box><size>0.90 0.16 0.12</size></box></geometry><material><diffuse>0.07 0.08 0.09 1</diffuse></material></visual>
        <visual name="packing_roller_1"><pose>1.70 -1.36 0.87 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>0.82</length></cylinder></geometry><material><diffuse>0.80 0.82 0.76 1</diffuse></material></visual>
        <visual name="packing_roller_2"><pose>2.00 -1.36 0.87 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>0.82</length></cylinder></geometry><material><diffuse>0.80 0.82 0.76 1</diffuse></material></visual>
        <visual name="packing_roller_3"><pose>2.30 -1.36 0.87 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>0.82</length></cylinder></geometry><material><diffuse>0.80 0.82 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <!-- BEGIN AMR_SHOWCASE_SEMANTIC_FLOOR -->
    <model name="showcase_zone_floor">
      <static>true</static>
      <pose>0 0 0.035 0 0 0</pose>
      <link name="link">
        <visual name="receiving_zone"><pose>-3.70 0.00 0 0 0 0</pose><geometry><box><size>1.25 1.50 0.012</size></box></geometry><material><diffuse>0.30 0.50 0.40 0.16</diffuse><ambient>0.30 0.50 0.40 0.16</ambient></material></visual>
        <visual name="storage_a_zone"><pose>1.50 1.50 0 0 0 0.30</pose><geometry><box><size>1.65 1.10 0.012</size></box></geometry><material><diffuse>0.70 0.60 0.40 0.16</diffuse><ambient>0.70 0.60 0.40 0.16</ambient></material></visual>
        <visual name="storage_b_zone"><pose>-2.00 2.00 0 0 0 -0.40</pose><geometry><box><size>1.65 1.15 0.012</size></box></geometry><material><diffuse>0.70 0.60 0.40 0.16</diffuse><ambient>0.70 0.60 0.40 0.16</ambient></material></visual>
        <visual name="packing_zone"><pose>2.00 -2.00 0 0 0 0</pose><geometry><box><size>1.30 1.85 0.012</size></box></geometry><material><diffuse>0.34 0.46 0.62 0.16</diffuse><ambient>0.34 0.46 0.62 0.16</ambient></material></visual>
        <visual name="dock_zone"><pose>-3.90 -3.80 0 0 0 0</pose><geometry><box><size>1.35 1.35 0.012</size></box></geometry><material><diffuse>0.32 0.52 0.42 0.16</diffuse><ambient>0.32 0.52 0.42 0.16</ambient></material></visual>
        <visual name="elevator_zone"><pose>3.65 2.85 0 0 0 0</pose><geometry><box><size>1.70 2.30 0.012</size></box></geometry><material><diffuse>0.46 0.42 0.62 0.15</diffuse><ambient>0.46 0.42 0.62 0.15</ambient></material></visual>
        <visual name="traffic_control_zone"><pose>0.00 0.00 0.006 0 0 0</pose><geometry><box><size>1.90 1.90 0.012</size></box></geometry><material><diffuse>0.72 0.64 0.40 0.14</diffuse><ambient>0.72 0.64 0.40 0.14</ambient></material></visual>
        <visual name="slow_zone_overlay"><pose>1.20 -0.25 0.012 0 0 0</pose><geometry><box><size>1.55 1.25 0.012</size></box></geometry><material><diffuse>0.08 0.56 1.0 0.20</diffuse><ambient>0.08 0.56 1.0 0.20</ambient></material></visual>
      </link>
    </model>

    <model name="showcase_lane_markers">
      <static>true</static>
      <pose>0 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="lane_dock_receiving"><pose>-3.90 -1.90 0 0 0 1.5708</pose><geometry><box><size>3.10 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="lane_receiving_storage_a"><pose>-1.10 0.75 0 0 0 0.2808</pose><geometry><box><size>5.40 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="lane_receiving_storage_b"><pose>-2.85 1.00 0 0 0 0.8663</pose><geometry><box><size>2.65 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="lane_storage_a_packing"><pose>1.75 -0.25 0 0 0 -1.4289</pose><geometry><box><size>3.55 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="lane_storage_b_packing"><pose>0.00 0.00 0.004 0 0 -0.7854</pose><geometry><box><size>5.65 0.045 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.34</diffuse><emissive>0.05 0.05 0.04 1</emissive></material></visual>
        <visual name="lane_packing_dock"><pose>-0.95 -2.90 0 0 0 -2.8450</pose><geometry><box><size>6.20 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="lane_packing_lift"><pose>2.83 0.43 0 0 0 1.2315</pose><geometry><box><size>4.95 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="lane_lift_floor2"><pose>3.65 3.35 0 0 0 1.5708</pose><geometry><box><size>1.05 0.055 0.018</size></box></geometry><material><diffuse>0.60 0.62 0.58 0.40</diffuse><emissive>0.06 0.06 0.05 1</emissive></material></visual>
        <visual name="arrow_receiving"><pose>-3.28 0.34 0.020 0 0 0.78</pose><geometry><cone><radius>0.11</radius><length>0.18</length></cone></geometry><material><diffuse>0.64 0.66 0.60 0.55</diffuse><emissive>0.08 0.08 0.06 1</emissive></material></visual>
        <visual name="arrow_packing"><pose>1.82 -1.36 0.020 0 0 -1.2</pose><geometry><cone><radius>0.11</radius><length>0.18</length></cone></geometry><material><diffuse>0.64 0.66 0.60 0.55</diffuse><emissive>0.08 0.08 0.06 1</emissive></material></visual>
        <visual name="arrow_dock"><pose>-3.82 -3.18 0.020 0 0 -1.57</pose><geometry><cone><radius>0.11</radius><length>0.18</length></cone></geometry><material><diffuse>0.64 0.66 0.60 0.55</diffuse><emissive>0.08 0.08 0.06 1</emissive></material></visual>
      </link>
    </model>

    <model name="showcase_station_pads">
      <static>true</static>
      <pose>0 0 0.070 0 0 0</pose>
      <link name="link">
        <visual name="pad_receiving"><pose>-3.70 0.00 0 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.026</length></cylinder></geometry><material><diffuse>0.04 0.86 0.48 0.70</diffuse><emissive>0.00 0.22 0.09 1</emissive></material></visual>
        <visual name="pad_storage_a"><pose>1.50 1.50 0 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.026</length></cylinder></geometry><material><diffuse>0.74 0.62 0.34 0.55</diffuse><emissive>0.24 0.12 0.00 1</emissive></material></visual>
        <visual name="pad_storage_b"><pose>-2.00 2.00 0 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.026</length></cylinder></geometry><material><diffuse>0.74 0.62 0.34 0.55</diffuse><emissive>0.24 0.12 0.00 1</emissive></material></visual>
        <visual name="pad_packing"><pose>2.00 -2.00 0 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.026</length></cylinder></geometry><material><diffuse>0.34 0.52 0.68 0.55</diffuse><emissive>0.00 0.14 0.30 1</emissive></material></visual>
        <visual name="pad_dock"><pose>-3.90 -3.80 0 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.026</length></cylinder></geometry><material><diffuse>0.06 0.90 0.34 0.72</diffuse><emissive>0.00 0.26 0.08 1</emissive></material></visual>
        <visual name="pad_lift"><pose>3.65 2.85 0 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.026</length></cylinder></geometry><material><diffuse>0.56 0.40 1.00 0.72</diffuse><emissive>0.10 0.04 0.28 1</emissive></material></visual>
        <visual name="wait_point_1"><pose>-1.05 0.62 0.012 0 0 0.28</pose><geometry><box><size>0.42 0.18 0.026</size></box></geometry><material><diffuse>0.78 0.68 0.34 0.60</diffuse><emissive>0.28 0.20 0.00 1</emissive></material></visual>
        <visual name="wait_point_2"><pose>0.88 -0.52 0.012 0 0 -0.78</pose><geometry><box><size>0.42 0.18 0.026</size></box></geometry><material><diffuse>0.78 0.68 0.34 0.60</diffuse><emissive>0.28 0.20 0.00 1</emissive></material></visual>
      </link>
    </model>

    <model name="showcase_pallets_and_totes">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="receiving_pallet"><pose>-3.42 -0.86 0.08 0 0 0.08</pose><geometry><box><size>0.68 0.46 0.16</size></box></geometry><material><diffuse>0.58 0.38 0.16 1</diffuse></material></visual>
        <visual name="receiving_tote_1"><pose>-3.56 -0.86 0.30 0 0 0.08</pose><geometry><box><size>0.30 0.22 0.22</size></box></geometry><material><diffuse>0.64 0.52 0.36 1</diffuse></material></visual>
        <visual name="receiving_tote_2"><pose>-3.22 -0.83 0.30 0 0 0.08</pose><geometry><box><size>0.30 0.22 0.22</size></box></geometry><material><diffuse>0.64 0.52 0.36 1</diffuse></material></visual>
        <visual name="storage_a_tote_1"><pose>1.12 1.06 0.78 0 0 0.30</pose><geometry><box><size>0.34 0.22 0.18</size></box></geometry><material><diffuse>0.66 0.56 0.40 1</diffuse></material></visual>
        <visual name="storage_a_tote_2"><pose>1.50 1.15 0.78 0 0 0.30</pose><geometry><box><size>0.34 0.22 0.18</size></box></geometry><material><diffuse>0.66 0.56 0.40 1</diffuse></material></visual>
        <visual name="storage_b_tote_1"><pose>-2.32 1.58 0.78 0 0 -0.40</pose><geometry><box><size>0.34 0.22 0.18</size></box></geometry><material><diffuse>0.66 0.56 0.40 1</diffuse></material></visual>
        <visual name="storage_b_tote_2"><pose>-1.94 1.46 0.78 0 0 -0.40</pose><geometry><box><size>0.34 0.22 0.18</size></box></geometry><material><diffuse>0.66 0.56 0.40 1</diffuse></material></visual>
        <visual name="packing_bin"><pose>2.52 -2.45 0.18 0 0 0</pose><geometry><box><size>0.46 0.36 0.36</size></box></geometry><material><diffuse>0.05 0.18 0.30 1</diffuse></material></visual>
        <visual name="packing_ready_tote"><pose>2.02 -2.60 0.82 0 0 0</pose><geometry><box><size>0.34 0.24 0.20</size></box></geometry><material><diffuse>0.68 0.58 0.42 1</diffuse></material></visual>
      </link>
    </model>

    <model name="showcase_dock_guidance">
      <static>true</static>
      <pose>-3.90 -3.48 0.075 0 0 0</pose>
      <link name="link">
        <visual name="approach_lane"><pose>0 0 0 0 0 1.5708</pose><geometry><box><size>0.86 0.06 0.024</size></box></geometry><material><diffuse>0.12 0.95 0.34 0.86</diffuse><emissive>0.02 0.28 0.08 1</emissive></material></visual>
        <visual name="left_alignment"><pose>-0.28 -0.10 0.006 0 0 1.5708</pose><geometry><box><size>0.58 0.04 0.024</size></box></geometry><material><diffuse>0.12 0.95 0.34 0.86</diffuse><emissive>0.02 0.28 0.08 1</emissive></material></visual>
        <visual name="right_alignment"><pose>0.28 -0.10 0.006 0 0 1.5708</pose><geometry><box><size>0.58 0.04 0.024</size></box></geometry><material><diffuse>0.12 0.95 0.34 0.86</diffuse><emissive>0.02 0.28 0.08 1</emissive></material></visual>
      </link>
    </model>

    <model name="showcase_environment_polish">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="north_wall_safety_stripe"><pose>0 4.935 0.72 0 0 0</pose><geometry><box><size>8.70 0.026 0.055</size></box></geometry><material><diffuse>0.96 0.78 0.10 1</diffuse><emissive>0.20 0.12 0.00 1</emissive></material></visual>
